GROK_API_KEY=your_grok_key_here
# Optional model override; omit for automatic selection from the key's model catalog
# GROK_MODEL=grok-4.20-0309-non-reasoning
# Optional local voice preset (British male): bm_george or bm_lewis
JARVIS_TTS_VOICE=bm_george
# Optional absolute path; default is ~/Library/Application Support/JARVIS/speech on macOS
# JARVIS_SPEECH_DIR=/absolute/path/to/local/speech
