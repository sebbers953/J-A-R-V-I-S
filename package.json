{
  "name": "jarvis-hud",
  "version": "0.1.0",
  "private": true,
  "description": "JARVIS desktop command center",
  "main": "dist/electron/electron/main.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "start": "electron .",
    "build": "tsc -p tsconfig.electron.json && vite build",
    "typecheck": "tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.json",
    "test": "node --test scripts/*.test.cjs",
    "preview": "vite preview --host 0.0.0.0",
    "test:smoke": "node scripts/smoke.cjs",
    "test:electron": "node scripts/electron-smoke.cjs",
    "setup:voice": "node scripts/setup-local-voice.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "electron": "^39.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "@xai-official/sdk": "^0.2.5",
    "dotenv": "^18.0.9"
  }
}
